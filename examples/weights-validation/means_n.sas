data m; length g $1;
g='A'; x=1; y=2; w=1; output;
g='A'; x=3; y=.; w=3; output;
g='A'; x=100; y=7; w=0; output;
g='A'; x=-100; y=8; w=-2; output;
g='B'; x=999; y=999; w=.; output;
g='B'; x=.; y=4; w=2; output;

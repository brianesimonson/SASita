/* SAS ONLY: print/export the WORK reference tables already created by 01.
   No sampling or random-number generation is repeated.
   If WORK tables are gone, run corrected 01 instead.
   This file is generated by scripts/package-surveyselect-reference.mjs. */
%let output_folder = %sysfunc(pathname(sasuser));
%put NOTE: SURVEYSELECT reference CSV folder: &output_folder;

/* Print all small sampling tables and their descriptors, and export CSVs.
   BEST32 preserves enough decimal digits; uniform_hex is authoritative for RNG. */
%macro sassy_export_reference(table);
    %if %sysfunc(exist(work.&table)) %then %do;
        title "SURVEYSELECT reference: &table";
        proc contents data=work.&table varnum; run;
        proc print data=work.&table noobs; run;
        data ss_export;
            set work.&table;
            format _numeric_ best32.;
        run;
        proc export data=ss_export outfile="&output_folder/&table..csv"
            dbms=csv replace;
        run;
    %end;
    %else %put ERROR: Missing reference table &table. Inspect earlier SAS errors.;
%mend;
%sassy_export_reference(ss_frame);
%sassy_export_reference(ss_srs);
%sassy_export_reference(ss_srs_second_seed);
%sassy_export_reference(ss_srs_rate);
%sassy_export_reference(ss_srs_census);
%sassy_export_reference(ss_urs_collapsed);
%sassy_export_reference(ss_urs_hits);
%sassy_export_reference(ss_urs_reps);
%sassy_export_reference(ss_sys_integer);
%sassy_export_reference(ss_sys_fractional);
%sassy_export_reference(ss_strata_srs);
%sassy_export_reference(ss_strata_single_stream);
%sassy_export_reference(ss_strata_sys);
%sassy_export_reference(ss_uniform_mt32);
%sassy_export_reference(ss_uniform_default);
title;

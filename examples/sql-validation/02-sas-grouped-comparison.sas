/* SAS ONLY: GROUPED RETEST ONLY: run this entire file in SAS Studio, without CSV uploads or path edits.
   Expected values generated by Sassy v0.4.21; This corrected grouped comparison has passed actual SAS.
   Numeric criterion: relative 1e-10; character values compared too.
   Original row order and exact metadata/layout are not certified by sorted comparisons.
   Only sql_grouped runs here. No GROUP BY transformation warning is expected.
   Return Results and Log. */
%macro sql_check(base,expected);
 %if %sysfunc(exist(&base))=0 or %sysfunc(exist(&expected))=0 %then %do;
  %put ERROR: SQL comparison did not run because &base or &expected is missing.;
  %return;
 %end;
 proc sort data=&base out=sas_sql_check; by _all_; run;
 proc sort data=&expected out=app_sql_check; by _all_; run;
 title "SQL values: &base versus &expected";
 proc compare base=sas_sql_check compare=app_sql_check method=relative criterion=1e-10; run;
%mend;
data sql_a;length g $4;id=1;g='A';x=2;output;id=1;x=4;output;id=2;g='B';x=8;output;id=.;g='';x=.;output;run;
data sql_b;id=1;y=3;output;id=1;y=6;output;id=3;y=12;output;id=.;y=9;output;run;

/* sql_grouped */
proc datasets lib=work nolist;delete sql_grouped app_sql_grouped;quit;
proc sql;create table sql_grouped as select g,count(*) as rows_count,count(x) as nonmissing,count(distinct id) as unique_ids,sum(x) as total,mean(x) as average,avg(x) as average2,std(x) as sd,var(x) as variance,min(x) as lo,max(x) as hi from sql_a group by g order by g;quit;
data app_sql_grouped; length g $128 rows_count 8 nonmissing 8 unique_ids 8 total 8 average 8 average2 8 sd 8 variance 8 lo 8 hi 8; infile datalines4 dsd dlm=',' truncover; input g :$128. rows_count :best32. nonmissing :best32. unique_ids :best32. total :best32. average :best32. average2 :best32. sd :best32. variance :best32. lo :best32. hi :best32.;
datalines4;
"","1","0","0","","","","","","",""
"A","2","2","1","6","3","3","1.4142135623730951","2","2","4"
"B","1","1","1","8","8","8","","","8","8"
;;;;
run;
%sql_check(sql_grouped,app_sql_grouped);
title;

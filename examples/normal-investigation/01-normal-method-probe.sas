/* SAS ONLY: identify candidate NORMAL transforms, not a Sassy app example.
   Run the entire program and return HTML Results and log.
   No input files, folder settings, CSV imports or CSV downloads needed.
   Creates only NR_* WORK tables. Every candidate starts with the same seed.
   A match is evidence for these cases, not proof for all seeds/parameters. */
%put NOTE: SAS version: &sysvlong4 Platform: &sysscpl;
proc product_status; run;
data nr_summary;
    length generator $16 mode $8 candidate $24;
    length draws exact_z close_z uniform_checks exact_uniform max_abs_diff 8;
    stop;
run;

%macro nr_initialize(generator);
    %if &generator=DEFAULT %then %do;
        call streaminit(12345);
    %end;
    %else %do;
        call streaminit("&generator",12345);
    %end;
%mend;

%macro nr_candidate(generator,mode,method);
data nr_candidate;
    length z_hex next_u_hex $16;
    %nr_initialize(&generator);
    cached=.; have_cache=0;
    do id=1 to 512;
        next_u_hex='';
        %if &method=inverse %then %do;
            z=quantile('normal',rand('uniform'));
        %end;
        %else %if &method=inverse_complement %then %do;
            z=quantile('normal',1-rand('uniform'));
        %end;
        %else %if %index(&method,box)>0 %then %do;
            %if %index(&method,pair)>0 %then %do;
                if have_cache then do; z=cached; have_cache=0; end;
                else do;
            %end;
            u1=rand('uniform'); u2=rand('uniform');
            radius=sqrt(-2*log(u1)); angle=2*constant('pi')*u2;
            %if %index(&method,sin)>0 %then %do;
                z=radius*sin(angle); cached=radius*cos(angle);
            %end;
            %else %do;
                z=radius*cos(angle); cached=radius*sin(angle);
            %end;
            %if %index(&method,pair)>0 %then %do;
                have_cache=1; end;
            %end;
        %end;
        %else %do;
            %if %index(&method,pair)>0 %then %do;
                if have_cache then do; z=cached; have_cache=0; end;
                else do;
            %end;
            s=0;
            do until(s>0 and s<1);
                x=2*rand('uniform')-1; y=2*rand('uniform')-1;
                s=x*x+y*y;
            end;
            factor=sqrt(-2*log(s)/s);
            %if %index(&method,y)>0 %then %do;
                z=y*factor; cached=x*factor;
            %end;
            %else %do;
                z=x*factor; cached=y*factor;
            %end;
            %if %index(&method,pair)>0 %then %do;
                have_cache=1; end;
            %end;
        %end;
        z_hex=put(z,hex16.);
        %if &mode=MIXED %then %do;
            next_u_hex=put(rand('uniform'),hex16.);
        %end;
        %else %do;
            if id=512 then next_u_hex=put(rand('uniform'),hex16.);
        %end;
        output;
    end;
    keep id z z_hex next_u_hex;
run;
data nr_compare;
    merge nr_actual(rename=(z=actual_z z_hex=actual_hex next_u_hex=actual_next))
          nr_candidate(rename=(z=candidate_z z_hex=candidate_hex next_u_hex=candidate_next));
    by id;
    exact_z=(actual_hex=candidate_hex);
    abs_diff=abs(actual_z-candidate_z);
    close_z=(not missing(actual_z) and not missing(candidate_z)
             and abs_diff<=1e-12*max(1,abs(actual_z)));
    next_uniform_matches=.;
    if actual_next ne '' then next_uniform_matches=(actual_next=candidate_next);
run;
proc means data=nr_compare noprint;
    output out=nr_score n(actual_z)=draws
        sum(exact_z close_z next_uniform_matches)=exact_z close_z exact_uniform
        n(next_uniform_matches)=uniform_checks max(abs_diff)=max_abs_diff;
run;
data nr_score;
    length generator $16 mode $8 candidate $24;
    set nr_score(drop=_type_ _freq_);
    generator="&generator"; mode="&mode"; candidate="&method";
run;
proc append base=nr_summary data=nr_score; run;
%mend;

%macro nr_probe(generator,mode);
data nr_actual;
    length z_hex next_u_hex $16;
    %nr_initialize(&generator);
    do id=1 to 512;
        next_u_hex='';
        z=rand('normal'); z_hex=put(z,hex16.);
        %if &mode=MIXED %then %do;
            next_u_hex=put(rand('uniform'),hex16.);
        %end;
        %else %do;
            if id=512 then next_u_hex=put(rand('uniform'),hex16.);
        %end;
        output;
    end;
    keep id z z_hex next_u_hex;
run;
title "Actual SAS NORMAL values: &generator / &mode / seed 12345";
proc print data=nr_actual noobs;
    where id<=12 or id=512;
    format z best32.;
run;
%nr_candidate(&generator,&mode,inverse);
%nr_candidate(&generator,&mode,inverse_complement);
%nr_candidate(&generator,&mode,box_cos);
%nr_candidate(&generator,&mode,box_sin);
%nr_candidate(&generator,&mode,box_pair_cos);
%nr_candidate(&generator,&mode,box_pair_sin);
%nr_candidate(&generator,&mode,polar_x);
%nr_candidate(&generator,&mode,polar_y);
%nr_candidate(&generator,&mode,polar_pair_x);
%nr_candidate(&generator,&mode,polar_pair_y);
%mend;

%nr_probe(DEFAULT,NORMAL);
%nr_probe(DEFAULT,MIXED);
%nr_probe(MT32,NORMAL);
%nr_probe(MT32,MIXED);
title 'NORMAL candidate comparison: 512 exact/close matches and matching next uniforms indicate a candidate';
proc print data=nr_summary noobs;
    var generator mode candidate draws exact_z close_z uniform_checks exact_uniform max_abs_diff;
    format max_abs_diff e16.8;
run;
title;

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sassy native table version 1",
  "description": "Row keys, value types, supported formats and declared lengths also require cross-checking against the column descriptors.",
  "type": "object",
  "required": ["format", "version", "name", "columns", "rows"],
  "properties": {
    "format": {"const": "sassy-table"},
    "version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z_]\\w{0,31}$"},
    "columns": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object", "required": ["name", "type", "length", "format"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z_]\\w{0,31}$"},
          "type": {"enum": ["numeric", "character"]},
          "length": {"type": ["integer", "null"]},
          "format": {"type": ["string", "null"], "maxLength": 64}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "numeric"}}}, "then": {"properties": {"length": {"const": 8}}}},
          {"if": {"properties": {"type": {"const": "character"}}}, "then": {"properties": {"length": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 32767}]}}}}
        ]
      }
    },
    "rows": {
      "type": "array", "maxItems": 100000,
      "items": {"type": "object", "additionalProperties": {"anyOf": [{"type": "string"}, {"type": "null"}, {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308}]}}
    }
  }
}
